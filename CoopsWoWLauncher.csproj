<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">1.3.0</Version>
    <DefineConstants Condition="'$(StagingFeeds)' == 'true'">$(DefineConstants);STAGING_FEEDS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <AssemblyMetadata Include="LauncherFeedKey" Value="$(LauncherFeedKey)" />
    <AssemblyMetadata Include="LumenveilFeedKey" Value="$(LumenveilFeedKey)" />
    <AssemblyMetadata Include="StagingFeeds" Value="$(StagingFeeds)" />
    <AssemblyMetadata Include="LauncherFeedUrl" Value="$(LauncherFeedUrl)" />
    <AssemblyMetadata Include="LumenveilFeedUrl" Value="$(LumenveilFeedUrl)" />
    <AssemblyMetadata Include="FailStartup" Value="$(FailStartup)" />
  </ItemGroup>
</Project>
