<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="winforms/**/*.cs" />
    <Compile Remove="graphics-package/**/*.cs" />
    <Compile Include="../ReleaseUpdater.cs" Link="ReleaseUpdater.cs" />
    <Compile Include="../DownloadProgress.cs" Link="DownloadProgress.cs" />
    <Compile Include="../HdPackInstaller.cs" Link="HdPackInstaller.cs" />
    <Compile Include="../ClientOptions.cs" Link="ClientOptions.cs" />
    <None Include="../manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
